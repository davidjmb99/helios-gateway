PORT=3000
BUFFER_MS=5000

SUPABASE_URL=https://xngafuipiwxtkytuozin.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Configuración de Hermes Real
HERMES_ENABLED=true
HERMES_MOCK=false
HERMES_BASE_URL=http://hermes:8787
HERMES_ENDPOINT=/v1/chat/completions
HERMES_API_KEY=
HERMES_MODEL=default
HERMES_PROFILE=helios
CHATWOOT_TENANT_CONTEXTS_JSON={"2":{"tenant_id":"democoi1","clinic_id":"coi_demo","hermes_profile":"helios"}}
HERMES_CWD=/home/hermeswebui/.hermes/profiles/helios/workspace/helios
HERMES_SOUL_PATH=/home/hermeswebui/.hermes/profiles/helios/SOUL.md
HERMES_TIMEOUT_MS=30000

# Recuperación durable. Iniciar producción en observe.
HELIOS_RECOVERY_MODE=observe
HELIOS_BATCH_LEASE_MS=180000
HELIOS_OUTBOX_LEASE_MS=60000

# Dashboard administrativo. Mantener false salvo autorización explícita.
HELIOS_ADMIN_SHOW_PII=false
HELIOS_ADMIN_SESSION_SECRET=
HELIOS_ADMIN_SESSION_TTL_MS=28800000

CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=your_chatwoot_account_id_here
CHATWOOT_API_TOKEN=your_chatwoot_api_token_here
CHATWOOT_HUMAN_TEAM_ID=
CHATWOOT_HUMAN_ASSIGNEE_ID=
CHATWOOT_TIMEOUT_MS=15000

CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com

HUBSPOT_ACCESS_TOKEN=

CLINIC_ID=coi_demo
CLINIC_TIMEZONE=Europe/Madrid
CLINIC_TONE=es-ES
